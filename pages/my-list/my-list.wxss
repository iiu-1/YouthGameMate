.page {
  min-height: 100vh;
  padding: 20rpx 30rpx 140rpx;
  box-sizing: border-box;
}

.has-bottom-nav {
  padding-bottom: 160rpx;
}

.list-header {
  margin-bottom: 20rpx;
}

.list-header .title {
  font-size: 32rpx;
  font-weight: 600;
}

.post-card {
  margin-bottom: 20rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.post-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  margin: 16rpx 0 8rpx;
}

.post-desc {
  font-size: 26rpx;
  color: #666666;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.footer {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f5f5f5;
}

.footer-stats {
  display: flex;
  gap: 24rpx;
}

.delete-link {
  font-size: 24rpx;
  color: #ff4d4f;
}

.muted {
  font-size: 24rpx;
  color: #999999;
}

.time {
  font-size: 22rpx;
  color: #999999;
}
