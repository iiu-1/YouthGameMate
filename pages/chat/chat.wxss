.messages-list {
  padding: 30rpx;
  padding-bottom: 140rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.loading-state,
.empty-state {
  text-align: center;
  padding: 100rpx;
  color: #999999;
  font-size: 26rpx;
}

.message-item {
  display: flex;
  margin-bottom: 40rpx;
}

.message-item.self {
  flex-direction: row-reverse;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin: 0 20rpx;
}

.avatar-text {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin: 0 20rpx;
  background: linear-gradient(135deg, #6C5CE7 0%, #a29bfe 100%);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
}

.message-content {
  max-width: 70%;
}

.message-bubble {
  background: #FFFFFF;
  padding: 20rpx 28rpx;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  font-size: 28rpx;
  line-height: 1.5;
  word-break: break-word;
}

.message-item.self .message-bubble {
  background: linear-gradient(135deg, #6C5CE7 0%, #a29bfe 100%);
  color: #FFFFFF;
}

.message-time {
  display: block;
  font-size: 20rpx;
  color: #CCCCCC;
  margin-top: 8rpx;
  text-align: right;
}

.message-item.other .message-time {
  text-align: left;
  margin-left: 20rpx;
}

.input-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background: #FFFFFF;
  border-top: 1rpx solid #F0F0F0;
}

.message-input {
  flex: 1;
  background: #F5F5F5;
  border-radius: 50rpx;
  padding: 20rpx 30rpx;
  font-size: 28rpx;
}

.send-btn {
  background: #6C5CE7;
  color: #FFFFFF;
  border: none;
  border-radius: 50rpx;
  padding: 20rpx 40rpx;
  margin-left: 20rpx;
  font-size: 28rpx;
}