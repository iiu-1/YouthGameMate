.tabs {
  display: flex;
  background: #FFFFFF;
  border-bottom: 1rpx solid #F0F0F0;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 30rpx 0;
  font-size: 28rpx;
  color: #999999;
  position: relative;
}

.tab.active {
  color: #6C5CE7;
  font-weight: 600;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  background: linear-gradient(135deg, #6C5CE7 0%, #a29bfe 100%);
  border-radius: 3rpx;
}

.message-list,
.notification-list {
  padding: 20rpx 0;
}

.loading-state {
  text-align: center;
  padding: 100rpx;
  color: #999999;
}

.conversation-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid #F5F5F5;
}

.conversation-item:active {
  background: #F8F8F8;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-right: 24rpx;
}

.avatar-text {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  background: linear-gradient(135deg, #6C5CE7 0%, #a29bfe 100%);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 600;
}

.conv-content {
  flex: 1;
  overflow: hidden;
}

.conv-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.nickname {
  font-size: 30rpx;
  font-weight: 500;
  color: #333333;
}

.time {
  font-size: 22rpx;
  color: #999999;
}

.conv-preview {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.last-message {
  font-size: 26rpx;
  color: #999999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 400rpx;
}

.unread-badge {
  background: #FF6B6B;
  color: #FFFFFF;
  min-width: 36rpx;
  height: 36rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  padding: 0 10rpx;
}

.empty-state {
  text-align: center;
  padding: 100rpx 0;
  color: #999999;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 30rpx;
  display: block;
  opacity: 0.3;
}

.sub-text {
  display: block;
  font-size: 24rpx;
  margin-top: 16rpx;
}

.notification-item {
  margin: 20rpx 30rpx;
  padding: 28rpx;
}

.n-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.n-body {
  display: block;
  font-size: 26rpx;
  color: #666666;
  line-height: 1.5;
}

.n-time {
  display: block;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #999999;
}