.bottom-nav {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 900;
  display: flex;
  align-items: stretch;
  justify-content: space-around;
  padding: 12rpx 0 calc(12rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid #eeeeee;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.nav-item {
  flex: 1;
  text-align: center;
  padding: 8rpx 0;
}

.nav-label {
  font-size: 22rpx;
  color: #888888;
}

.nav-item.on .nav-label {
  color: #6c5ce7;
  font-weight: 600;
}
