.container {
  min-height: 100vh;
  background: #0F0F1A;
}

.match-header {
  background: linear-gradient(180deg, #1A1A2E 0%, #16213E 100%);
  padding: 60rpx 32rpx 40rpx;
  position: relative;
  overflow: hidden;
}

.match-header::before {
  content: '';
  position: absolute;
  top: -100rpx;
  right: -100rpx;
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(circle, rgba(102, 126, 234, 0.15) 0%, transparent 70%);
  pointer-events: none;
}

.header-inner {
  position: relative;
  z-index: 1;
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.logo-area {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.logo-icon {
  font-size: 56rpx;
}

.title-wrap {
  display: flex;
  flex-direction: column;
}

.header-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 1rpx;
}

.header-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-top: 4rpx;
}

.refresh-btn {
  width: 72rpx;
  height: 72rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.refresh-icon {
  font-size: 32rpx;
  color: #FFFFFF;
  font-weight: 300;
}

.filter-bar {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.filter-chips {
  display: flex;
  gap: 16rpx;
}

.chip {
  padding: 14rpx 28rpx;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 40rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  transition: all 0.25s ease;
}

.chip.active {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-color: transparent;
  box-shadow: 0 4rpx 20rpx rgba(102, 126, 234, 0.4);
}

.chip-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  font-weight: 500;
}

.chip.active .chip-text {
  color: #FFFFFF;
}

.match-content {
  padding: 32rpx 24rpx;
}

.result-header {
  margin-bottom: 24rpx;
  padding-left: 8rpx;
}

.result-count {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.4);
}

.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 0;
}

.loading-anim {
  display: flex;
  gap: 12rpx;
  margin-bottom: 32rpx;
}

.loading-dot {
  width: 16rpx;
  height: 16rpx;
  background: #667eea;
  border-radius: 50%;
  animation: bounce 1.4s ease-in-out infinite;
}

.loading-dot:nth-child(1) { animation-delay: 0s; }
.loading-dot:nth-child(2) { animation-delay: 0.2s; }
.loading-dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes bounce {
  0%, 80%, 100% { transform: scale(0.6); opacity: 0.4; }
  40% { transform: scale(1); opacity: 1; }
}

.loading-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.5);
}

.card-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.match-card {
  background: linear-gradient(145deg, #1E1E32 0%, #252540 100%);
  border-radius: 24rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  position: relative;
  overflow: hidden;
}

.match-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3rpx;
  background: linear-gradient(90deg, transparent 0%, #667eea 50%, transparent 100%);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.match-card:active::before {
  opacity: 1;
}

.card-main {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
}

.avatar-ring {
  position: relative;
  flex-shrink: 0;
}

.avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 600;
  border: 3rpx solid rgba(102, 126, 234, 0.3);
}

.avatar.avatar-hot {
  border-color: #FF6B6B;
  box-shadow: 0 0 30rpx rgba(255, 107, 107, 0.3);
}

.avatar-glow {
  position: absolute;
  top: -4rpx;
  left: -4rpx;
  right: -4rpx;
  bottom: -4rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  opacity: 0;
  z-index: -1;
  filter: blur(16rpx);
  transition: opacity 0.3s ease;
}

.avatar.avatar-hot + .avatar-glow {
  opacity: 0.4;
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E8E 100%);
}

.user-info {
  flex: 1;
  min-width: 0;
}

.name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.nickname {
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
  max-width: 180rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.gender-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.gender-dot.male {
  background: #1890FF;
}

.gender-dot.female {
  background: #FF6B6B;
}

.grade-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
  background: rgba(255, 255, 255, 0.08);
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.games-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 12rpx;
}

.game-chip {
  font-size: 22rpx;
  color: #FFFFFF;
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.4) 0%, rgba(118, 75, 162, 0.4) 100%);
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  border: 1rpx solid rgba(102, 126, 234, 0.3);
}

.tags-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.tag-item {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.6);
  background: rgba(255, 255, 255, 0.06);
  padding: 6rpx 14rpx;
  border-radius: 6rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.score-area {
  flex-shrink: 0;
  display: flex;
  align-items: flex-start;
}

.score-badge {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 18rpx;
  border-radius: 16rpx;
  min-width: 90rpx;
}

.score-badge.hot {
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E8E 100%);
  box-shadow: 0 4rpx 20rpx rgba(255, 107, 107, 0.3);
}

.score-badge.warm {
  background: linear-gradient(135deg, #FFB347 0%, #FFCE73 100%);
  box-shadow: 0 4rpx 20rpx rgba(255, 179, 71, 0.3);
}

.score-badge.normal {
  background: rgba(255, 255, 255, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.15);
}

.score-num {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.score-badge.normal .score-num {
  color: rgba(255, 255, 255, 0.7);
}

.score-label {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 2rpx;
}

.score-badge.normal .score-label {
  color: rgba(255, 255, 255, 0.5);
}

.card-footer {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
  display: flex;
  justify-content: center;
}

.chat-btn {
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #FFFFFF;
  border: none;
  border-radius: 50rpx;
  padding: 18rpx 48rpx;
  font-size: 26rpx;
  font-weight: 500;
  box-shadow: 0 4rpx 20rpx rgba(102, 126, 234, 0.35);
}

.chat-icon {
  font-size: 28rpx;
}

.chat-text {
  font-weight: 500;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 60rpx;
  background: linear-gradient(145deg, #1E1E32 0%, #252540 100%);
  border-radius: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 32rpx;
  opacity: 0.5;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #FFFFFF;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.45);
  text-align: center;
  line-height: 1.7;
  margin-bottom: 48rpx;
}

.btn-primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #FFFFFF;
  border: none;
  border-radius: 50rpx;
  padding: 24rpx 64rpx;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 32rpx rgba(102, 126, 234, 0.4);
}