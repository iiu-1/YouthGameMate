.post-page {
  min-height: 100vh;
}

.expired-tip {
  margin: 20rpx 30rpx 0;
  padding: 20rpx 24rpx;
  background: #fff7e6;
  color: #ad6800;
  border-radius: 12rpx;
  font-size: 26rpx;
}

.post-header {
  padding: 30rpx;
}

.user-row {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.avatar-text {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background: linear-gradient(135deg, #6C5CE7 0%, #a29bfe 100%);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
}

.user-info {
  flex: 1;
}

.nickname {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.time {
  font-size: 22rpx;
  color: #999999;
}

.game-tag {
  margin-left: auto;
}

.post-title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
  line-height: 1.4;
}

.post-content {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.7;
  margin-bottom: 24rpx;
}

.post-tags {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 20rpx;
}

.post-meta {
  display: flex;
  gap: 30rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #F5F5F5;
}

.meta-item {
  font-size: 24rpx;
  color: #999999;
}

.owner-actions {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #F5F5F5;
}

.delete-post-btn {
  display: inline-block;
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  color: #ff4d4f;
  border: 1rpx solid rgba(255, 77, 79, 0.45);
  border-radius: 12rpx;
}

.action-bar {
  display: flex;
  justify-content: space-around;
  padding: 20rpx 30rpx;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.action-icon {
  font-size: 40rpx;
}

.action-count,
.action-text {
  font-size: 22rpx;
  color: #666666;
}

.action-item.active .action-text {
  color: #6C5CE7;
}

.comments-section {
  padding: 30rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 30rpx;
}

.count {
  color: #999999;
  font-weight: normal;
  margin-left: 8rpx;
}

.comments-list {
  margin-bottom: 120rpx;
}

.comment-item {
  display: flex;
  margin-bottom: 30rpx;
}

.comment-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.comment-avatar.avatar-text {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background: linear-gradient(135deg, #6C5CE7 0%, #a29bfe 100%);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
}

.comment-content {
  flex: 1;
}

.comment-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.comment-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #333333;
}

.comment-time {
  font-size: 20rpx;
  color: #999999;
}

.comment-text {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
}

.empty-comments {
  text-align: center;
  padding: 60rpx;
  color: #999999;
  font-size: 26rpx;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background: #FFFFFF;
  border-top: 1rpx solid #F0F0F0;
}

.comment-input {
  flex: 1;
  background: #F5F5F5;
  border-radius: 50rpx;
  padding: 20rpx 30rpx;
  font-size: 26rpx;
}

.send-btn {
  background: #6C5CE7;
  color: #FFFFFF;
  border: none;
  border-radius: 50rpx;
  padding: 16rpx 36rpx;
  margin-left: 20rpx;
  font-size: 26rpx;
}