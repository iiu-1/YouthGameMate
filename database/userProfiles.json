      "description": "性别 0-未知 1-男 2-女"
    },
    {
      "fieldName": "grade",
      "type": "string",
      "description": "年级"
    },
    {
      "fieldName": "dormitory",
      "type": "string",
      "description": "宿舍楼"
    },
    {
      "fieldName": "school",
      "type": "string",
      "description": "学校名称"
    },
    {
      "fieldName": "campus",
      "type": "string",
      "description": "校区"
    },
    {
      "fieldName": "studentId",
      "type": "string",
      "description": "学号"
    },
    {
      "fieldName": "realName",
      "type": "string",
