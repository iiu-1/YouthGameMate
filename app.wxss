page {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
  background-color: #F8F9FA;
  font-size: 28rpx;
  color: #333333;
}

.container {
  min-height: 100vh;
  box-sizing: border-box;
}

.card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.btn-primary {
  background: linear-gradient(135deg, #6C5CE7 0%, #a29bfe 100%);
  color: #FFFFFF;
  border: none;
  border-radius: 50rpx;
  padding: 24rpx 48rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.btn-primary::after {
  border: none;
}

.btn-secondary {
  background: #FFFFFF;
  color: #6C5CE7;
  border: 2rpx solid #6C5CE7;
  border-radius: 50rpx;
  padding: 22rpx 48rpx;
  font-size: 28rpx;
}

.tag {
  display: inline-block;
  padding: 8rpx 16rpx;
  background: #F0F0FF;
  color: #6C5CE7;
  border-radius: 8rpx;
  font-size: 22rpx;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
}

.tag-game {
  background: linear-gradient(135deg, #6C5CE7 0%, #a29bfe 100%);
  color: #FFFFFF;
}

.tag-hot {
  background: #FF6B6B;
  color: #FFFFFF;
}

.input-item {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.input-label {
  width: 180rpx;
  color: #666666;
  font-size: 28rpx;
}

.input-value {
  flex: 1;
  color: #333333;
  font-size: 28rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #F0F0FF;
}

.empty-state {
  text-align: center;
  padding: 100rpx 0;
  color: #999999;
  font-size: 26rpx;
}

.empty-state image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
  opacity: 0.5;
}

.has-bottom-nav {
  padding-bottom: 140rpx;
  box-sizing: border-box;
}