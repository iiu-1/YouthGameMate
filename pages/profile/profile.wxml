<view class="container has-bottom-nav">
  <view class="profile-header">
    <view class="user-card">
      <view class="user-info-section">
        <image wx:if="{{userInfo.avatarUrl}}" class="avatar-img" src="{{userInfo.avatarUrl}}" mode="aspectFill"/>
        <view wx:else class="avatar">{{userInfo.nickName.charAt(0)}}</view>
        <view class="info-content">
          <view class="nickname">{{userInfo.nickName}}</view>
          <view class="auth-status {{authStatus}}">
            <text wx:if="{{authStatus === 'verified'}}">✅ 已认证</text>
            <text wx:elif="{{authStatus === 'pending'}}">⏳ 认证中</text>
            <text wx:else>❌ 未认证</text>
          </view>
        </view>
        <view class="edit-btn" bindtap="goToEditProfile">
          <text>编辑</text>
        </view>
      </view>
      
      <view wx:if="{{!userInfo.hasWxAuth}}" class="wx-login-btn" bindtap="wxLogin">
        <text class="login-icon">📱</text>
        <text>微信登录</text>
      </view>
    </view>

    <view class="stats-bar">
      <view class="stat-item">
        <text class="stat-num">{{stats.postCount}}</text>
        <text class="stat-label">发帖</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-num">{{stats.collectCount}}</text>
        <text class="stat-label">收藏</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-num">{{stats.followCount}}</text>
        <text class="stat-label">关注</text>
      </view>
    </view>
  </view>

  <view class="menu-section card">
    <view 
      wx:for="{{menuItems}}" 
      wx:key="title"
      class="menu-item"
      bindtap="goToMenu"
      data-title="{{item.title}}"
    >
      <text class="menu-icon">{{item.icon}}</text>
      <text class="menu-title">{{item.title}}</text>
      <text class="menu-arrow">→</text>
    </view>
  </view>

  <view class="footer">
    <text class="version">校园游搭子 v1.0.0</text>
  </view>

  <bottom-nav active="profile" />
</view>