.profile-header {
  background: linear-gradient(135deg, #6C5CE7 0%, #a29bfe 100%);
  padding: 30rpx 30rpx 0;
}

.user-card {
  background: #FFFFFF;
  border-radius: 24rpx 24rpx 0 0;
  padding: 40rpx 30rpx;
}

.user-info-section {
  display: flex;
  align-items: center;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-right: 30rpx;
  background: linear-gradient(135deg, #6C5CE7 0%, #a29bfe 100%);
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 500;
}

.info-content {
  flex: 1;
}

.nickname {
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 12rpx;
}

.auth-status {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 50rpx;
  font-size: 22rpx;
}

.auth-status.verified {
  background: #E8F8E8;
  color: #52C41A;
}

.auth-status.pending {
  background: #FFF7E6;
  color: #FAAD14;
}

.auth-status.none {
  background: #F5F5F5;
  color: #999999;
}

.edit-btn {
  padding: 12rpx 28rpx;
  background: #F0F0FF;
  color: #6C5CE7;
  border-radius: 50rpx;
  font-size: 24rpx;
}

.login-section {
  display: flex;
  align-items: center;
}

.login-content {
  flex: 1;
}

.login-tip {
  display: block;
  font-size: 28rpx;
  color: #666666;
  margin-bottom: 20rpx;
}

.login-btn {
  background: linear-gradient(135deg, #6C5CE7 0%, #a29bfe 100%);
  color: #FFFFFF;
  border: none;
  border-radius: 50rpx;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
}

.stats-bar {
  display: flex;
  justify-content: center;
  align-items: center;
  background: #FFFFFF;
  padding: 30rpx;
  border-radius: 0 0 24rpx 24rpx;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-num {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #999999;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: #F0F0F0;
}

.menu-section {
  margin: 20rpx 30rpx;
  padding: 0;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx 30rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 24rpx;
}

.menu-title {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
}

.menu-arrow {
  color: #CCCCCC;
  font-size: 28rpx;
}

.logout-section {
  text-align: center;
  padding: 40rpx;
  color: #999999;
  font-size: 26rpx;
}

.footer {
  text-align: center;
  padding: 40rpx;
}

.version {
  font-size: 22rpx;
  color: #CCCCCC;
}